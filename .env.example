# ==========================================================
# Nubia Inventory - Environment Configuration
# Copy this file to ".env" and adjust the values.
# ==========================================================

APP_NAME="Nubia Inventory"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en

# ---------------------- Database --------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nubia_inventory
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------------------- Security --------------------------
APP_KEY=base64:CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
SESSION_NAME=nubia_session
SESSION_LIFETIME=120

# ---------------------- Mail (PHPMailer) ------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@nubiainventory.com
MAIL_FROM_NAME="Nubia Inventory"

# ---------------------- Business Defaults -----------------
DEFAULT_CURRENCY=BDT
DEFAULT_CURRENCY_SYMBOL=Tk
