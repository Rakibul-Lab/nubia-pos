{
    "name": "nubia/inventory",
    "description": "Nubia Inventory - Enterprise Inventory Management & POS System",
    "type": "project",
    "license": "proprietary",
    "keywords": ["inventory", "pos", "erp", "php", "mvc"],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^2.3",
        "endroid/qr-code": "^5.1",
        "picqer/php-barcode-generator": "^3.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8000 -t public public/index.php",
        "cs": "phpcs --standard=PSR12 app/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
